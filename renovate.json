{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["(^|/)profiles/.*/config\\.yml$"],
      "matchStrings": [
        "name: \"(?<depName>@[\\w.-]+/[\\w.-]+)@(?<currentValue>[\\d]+\\.[\\d]+\\.[\\d]+)\""
      ],
      "datasourceTemplate": "npm"
    }
  ],
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "lockFileMaintenance": { "enabled": false }
    },
    {
      "groupName": "ansible dependencies",
      "matchManagers": ["ansible-galaxy"],
      "matchDepTypes": ["collection", "role"]
    },
    {
      "groupName": "pre-commit hooks",
      "matchManagers": ["pre-commit"],
      "separateMajorMinor": false,
      "automerge": true
    },
    {
      "groupName": "pytest",
      "matchPackageNames": ["pytest", "/^pytest-/"]
    }
  ]
}
