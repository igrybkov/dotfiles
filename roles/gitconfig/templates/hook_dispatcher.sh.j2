#!/usr/bin/env bash
# Auto-generated by gitconfig role - do not edit manually
# Global git hook dispatcher for: {{ _hook_name }}
# Regenerate via: ansible-playbook playbook.yml --tags gitconfig
set -u

# Guards against a global- or trusted-scope snippet triggering a nested git
# command (e.g. a post-commit snippet running `git commit --amend`) that would
# otherwise recurse into hooks again. Suppresses ALL hook types in the nested
# invocation, not just this one — simplest safe behavior.
if [ -n "${GIT_HOOKS_DISPATCHER_ACTIVE:-}" ]; then exit 0; fi
export GIT_HOOKS_DISPATCHER_ACTIVE=1

rc=0
{% if _hook_name == 'pre-push' %}
# `$(...)` strips trailing newlines, so round-trip through a sentinel byte to
# preserve stdin exactly (pre-push gets ref update lines on stdin).
_stdin="$(cat; printf x)"; _stdin="${_stdin%x}"
{% endif %}

# 1. Chain to any repo-local hook that predates the global hooksPath.
# core.hooksPath makes git stop looking at $GIT_DIR/hooks entirely, so we must
# re-invoke it ourselves. Use --git-common-dir (worktree-safe), NEVER
# --git-path hooks/..., which resolves back through core.hooksPath itself.
# This is unconditional — a local hook file can only exist because something
# on THIS machine put it there (pre-commit install, husky, git-lfs, a
# hand-written script, ...), never via `git clone` itself, so trust doesn't
# gate it.
_git_common_dir="$(git rev-parse --git-common-dir 2>/dev/null)" || _git_common_dir=""
_local_hook_present=0
if [ -n "$_git_common_dir" ] && [ -x "$_git_common_dir/hooks/{{ _hook_name }}" ]; then
  _local_hook_present=1
{% if _hook_name == 'pre-push' %}
  printf '%s' "$_stdin" | "$_git_common_dir/hooks/{{ _hook_name }}" "$@" || rc=1
{% else %}
  "$_git_common_dir/hooks/{{ _hook_name }}" "$@" || rc=1
{% endif %}
fi

# 2. Global-scope actions: pure shell over git's own hook inputs, safe
# everywhere — always run, regardless of a local hook or trust.
{% for snippet in _hook_global_snippets %}
# --- {{ snippet.profile }} (priority {{ snippet.priority }}, order {{ snippet.order }}) ---
{{ snippet.script }}
# Intentionally capturing the snippet's own exit code.
# shellcheck disable=SC2320
step_rc=$?; [ "$step_rc" -eq 0 ] || rc=1
{% endfor %}

# 3. Trust gate: does any configured remote match an allowlisted glob?
# Normalizes away scheme/user@ prefix and scp-like ':' separator so a single
# declared pattern matches a repo regardless of whether it's cloned over ssh
# or https (git@host:org/repo.git and https://host/org/repo.git both
# normalize to host/org/repo).
_norm_git_url() {
  local u="$1"
  u="${u#ssh://}"; u="${u#git://}"; u="${u#https://}"; u="${u#http://}"
  u="${u#*@}"
  # No backslash before the replacement '/': bash 3.2 (macOS system bash,
  # what GUI git clients fall back to without a shell PATH) handles
  # `${u/:/\/}` differently than bash 5.x and leaves a literal backslash in
  # the result. Unescaped, both versions agree.
  u="${u/://}"
  u="${u%.git}"
  printf '%s\n' "$u"
}

_trusted=0
{% if _trusted_remote_patterns %}
_norm_patterns=()
{% for p in _trusted_remote_patterns %}
_norm_patterns+=("$(_norm_git_url {{ p | quote }})")
{% endfor %}

# Match each pattern individually rather than joining with '|': case-pattern
# alternation (pat1|pat2) only works when the '|' is literally present in the
# shell source at parse time, not when it arrives via variable expansion —
# there it's just an ordinary literal character in one big glob pattern.
while IFS= read -r _remote_line; do
  _url="${_remote_line#* }"
  _norm_url="$(_norm_git_url "$_url")"
  for _pat in "${_norm_patterns[@]}"; do
    # Intentionally glob-matching against $_pat, not literal.
    # shellcheck disable=SC2254
    case "$_norm_url" in
      $_pat) _trusted=1; break 2 ;;
    esac
  done
done < <(git config --get-regexp '^remote\..*\.url$' 2>/dev/null)
{% endif %}

# 4. Trusted-scope actions + automatic pre-commit: only when trusted AND no
# local hook already ran. A pre-existing local hook (any kind, not just
# pre-commit's) is this repo's own choice for how to handle this hook type —
# this global/automatic path exists only as a fallback for trusted repos
# that don't already have one, not to run alongside it.
if [ "$_trusted" -eq 1 ] && [ "$_local_hook_present" -eq 0 ]; then
  : # no-op guard: keeps the then-clause non-empty when nothing below renders
{% for snippet in _hook_trusted_snippets %}
  # --- {{ snippet.profile }} (priority {{ snippet.priority }}, order {{ snippet.order }}) ---
  {{ snippet.script }}
  # Intentionally capturing the snippet's own exit code.
  # shellcheck disable=SC2320
  step_rc=$?; [ "$step_rc" -eq 0 ] || rc=1
{% endfor %}
{% if _hook_name in git_hooks_precommit_types %}
  # GUI git clients (VS Code, JetBrains, ...) invoke hooks without a shell
  # PATH, so mise shims won't resolve via `command -v` — fall back to their
  # known absolute locations before giving up.
  if command -v pre-commit >/dev/null 2>&1; then
    _pc=(pre-commit)
  elif command -v uvx >/dev/null 2>&1; then
    _pc=(uvx {{ git_hooks_precommit_uvx_spec }})
  elif [ -x "$HOME/.local/share/mise/shims/uvx" ]; then
    _pc=("$HOME/.local/share/mise/shims/uvx" {{ git_hooks_precommit_uvx_spec }})
  elif [ -x "$HOME/.local/bin/uvx" ]; then
    _pc=("$HOME/.local/bin/uvx" {{ git_hooks_precommit_uvx_spec }})
  else
    echo "hook_dispatcher({{ _hook_name }}): trusted repo but no pre-commit or uvx found" 1>&2
    exit 1
  fi
{% if _hook_name == 'pre-push' %}
  printf '%s' "$_stdin" | "${_pc[@]}" hook-impl --config={{ git_hooks_precommit_config }} --hook-type={{ _hook_name }} --skip-on-missing-config -- "$@" || rc=1
{% else %}
  "${_pc[@]}" hook-impl --config={{ git_hooks_precommit_config }} --hook-type={{ _hook_name }} --skip-on-missing-config -- "$@" || rc=1
{% endif %}
{% endif %}
fi

exit $rc
